<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.knock</groupId>
        <artifactId>knock-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>knock-core</artifactId>
    <name>Knock :: Core</name>
    <description>Implémentation MicroProfile Health 4.0 standalone — registry, agrégation, sérialisation JSON</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-api</artifactId>
        </dependency>
        <!-- JSON-P API (implémentation runtime : champollion) -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation JSON-P pour les tests -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JPMS workaround knock-core — module-info isole pour eviter la detection JPMS
                lors de testCompile (voir docs/adr/ADR-001-jpms-workaround-microprofile-health.md).

                Probleme specifique a knock-core : Maven Compiler Plugin 4.0.0-beta-4 detecte
                le mode JPMS des que module-info.class est present dans target/classes. En mode
                JPMS pour testCompile, il reconstruit un module-path qui ne contient pas les
                dependances test-scope, ce qui casse la compilation des tests.

                Solution en trois temps :

                1. module-info.java hors de src/main/java (dans src/main/module-info) :
                   default-compile ne le voit pas → pas de module-info.class dans
                   target/classes → Maven ne detecte pas JPMS pour testCompile.

                2. maven-clean-plugin (generate-test-sources) supprime l'eventuel
                   module-info.class stale de target/classes avant testCompile (builds
                   incrementaux : evite la detection JPMS sur une classe residuelle).

                3. maven-compiler-plugin (prepare-package) recompile module-info.java seul
                   dans target/classes avant l'assemblage du JAR — le JAR final embarque
                   bien module-info.class.

                Consequence : les tests de knock-core s'executent sur le classpath
                (useModulePath=false). C'est intentionnel : les tests unitaires valident la
                logique metier ; le cablage JPMS (ServiceLoader, module graph) est valide par
                le smoke test TCK dans knock-tck.

                Compatibilite jlink : le fork io.vidocq.knock:knock-mp-health-api
                embarque un module-info et ne requiert pas de module automatique.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
