<?xml version="1.0" encoding="UTF-8"?>
<!--
    Knock on Open Liberty (MicroProfile 7 distribution). Only the Jakarta features Knock builds on:
    mpHealth stays off, otherwise Liberty would answer /health itself.
-->
<server description="knock-it-openliberty">
    <featureManager>
        <feature>cdi-4.0</feature>
        <feature>restfulWS-3.1</feature>
        <feature>jsonp-2.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="localhost" httpPort="${http.port}" httpsPort="${https.port}"/>

    <webApplication location="knock-it-openliberty.war" contextRoot="/knock"/>
</server>
