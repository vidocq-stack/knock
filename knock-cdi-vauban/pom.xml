<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.knock</groupId>
        <artifactId>knock-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>knock-cdi-vauban</artifactId>
    <name>Knock :: CDI Vauban Integration</name>

    <properties>
        <!-- Every class here is package-private (ServiceLoader provider + generated
             wiring only). javadoc has no public API to document; still produce the
             (empty) javadoc jar for the release train instead of failing the build. -->
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
    </properties>
    <description>Intégration CDI 4.1 (Vauban) — découverte auto des @Liveness/@Readiness/@Startup via BCE</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.knock</groupId>
            <artifactId>knock-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- CDI container for integration tests -->
        <!-- Compile-only (optional at runtime): supplies the VaubanComponentProvider service type
             named in module-info `provides`. Non-transitive; absent under non-Vauban containers. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT-processed dependency jars). During
                the main compile it generates _ClientProxy/_Factory (so @ApplicationScoped beans —
                KnockCdiHealthCheckRegistry, HealthCheckRegistrar — are proxied), META-INF/
                vauban-beans.list (runtime discovery on the module path), and one _VaubanComponents
                per package (in-module instantiation/field-injection/observer invocation, no `opens`).
                Build-time only: adds no compile/runtime dependency on Vauban, and the output stays
                inert for a standard CDI container (Weld).
            -->
            <!--
                Java Modules workaround for knock-cdi-vauban: same issue as knock-core.
                vauban-core is test-scope, absent from target/javamodules/; if
                module-info.class is in target/classes, Maven enables Java Modules for
                testCompile and cannot resolve test modules on the module path.
                Same three-step solution (see ADR-001 and knock-core/pom.xml).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- process-resources (just before `compile`), NOT generate-test-sources:
                             removes a stale module-info.class left in target/classes by a prior
                             prepare-package `compile-module-info`, so a non-clean install/deploy
                             (e.g. CI cache) doesn't trip default-compile into module mode. -->
                        <id>remove-stale-module-info-before-compile</id>
                        <phase>process-resources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Vauban APT processes this module's own beans at compile time. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <!-- No annotation processing on the separate module-info compile
                                 (the beans were already processed in the main compile). -->
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
