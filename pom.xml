<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <groupId>io.vidocq.knock</groupId>
    <artifactId>knock-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Knock</name>
    <description>Implémentation MicroProfile Health 4.0 — zéro librairie tierce, virtual threads, JPMS strict</description>
    <url>https://forge.vidocq.dev/vidocq/knock</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://forge.vidocq.dev/vidocq/knock</url>
        <connection>scm:git:https://forge.vidocq.dev/vidocq/knock.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/knock.git</developerConnection>
    </scm>

    <distributionManagement>
        <repository>
            <id>vidocq-releases</id>
            <url>https://repo.vidocq.dev/releases</url>
        </repository>
        <snapshotRepository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>vidocq-releases</id>
            <url>https://repo.vidocq.dev/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>vidocq-releases</id>
            <url>https://repo.vidocq.dev/releases</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!--
            MicroProfile Health API 4.0.1 — fork Vidocq avec module-info
            pour JPMS/jlink. La version upstream est gardee a titre indicatif.
        -->
        <microprofile.health.api.version>${project.version}</microprofile.health.api.version>
        <microprofile.health.upstream.version>4.0.1</microprofile.health.upstream.version>

        <!-- Jakarta JSON-P — implémentation fournie par champollion -->
        <jakarta.json.version>2.1.3</jakarta.json.version>

        <!-- Jakarta REST — implémentation fournie par Cassini -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- CDI -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Vidocq upstreams (référencés via property pour overridabilité PR cross-repo) -->
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <champollion.version>0.1.0-SNAPSHOT</champollion.version>
        <cassini.version>0.1.0-SNAPSHOT</cassini.version>

        <!-- JUnit 6 minimum (requiert Java 17+, on tourne en Java 25) -->
        <junit.version>6.0.3</junit.version>
    </properties>

    <!--
        knock-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser
        les POMs Model 4.1.0. Il sera invoqué par run-official-tck-mp-health-4.0.sh
        après installation locale du reactor.
    -->
    <subprojects>
        <subproject>knock-mp-health-api</subproject>
        <subproject>knock-api</subproject>
        <subproject>knock-core</subproject>
        <subproject>knock-cdi-vauban</subproject>
        <subproject>knock-cassini</subproject>
    </subprojects>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit BOM -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MicroProfile Health API (fork Vidocq avec module-info) -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-mp-health-api</artifactId>
                <version>${microprofile.health.api.version}</version>
            </dependency>

            <!-- Jakarta JSON-P (implémentation : champollion) -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>

            <!-- Jakarta REST (implémentation : Cassini) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Implémentations runtime (Vidocq) — versions via property pour
                 que le mécanisme cross-repo PR puisse les overrider. -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Modules internes Knock -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>4.0.0-beta-4</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!--
            JPMS : le fork knock-mp-health-api embarque un module-info et peut
            etre place sur le module-path. On conserve target/javamodules pour
            aligner la resolution javac/jlink et les builds multi-modules.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-javamodules-before-copy</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/javamodules</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!--
                        Copie toutes les dependances compile et provided dans target/javamodules.
                        Cela inclut knock-mp-health-api (fork avec module-info),
                        knock-api, jakarta.json, etc. Notre argument javac module-path prend
                        precedence car javac utilise le premier module-path rencontre.
                        includeScope=compile : compile et provided, pas test ni runtime.
                    -->
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
