<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.knock</groupId>
    <artifactId>knock-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Knock</name>
    <description>Implémentation MicroProfile Health 4.0 — zéro librairie tierce, virtual threads, Java Modules strict</description>
    <url>https://codeberg.org/Vidocq/knock</url>

    <!--
        Disjunctive triple license: a recipient may use this software under
        ANY ONE of the three licences below, at their option. EPL-2.0 is the
        anchor (see the LICENSE file); per EPL-2.0 section 1, GPL-2.0-or-later
        is offered as a Secondary License.
        SPDX-License-Identifier: EPL-2.0 OR EUPL-1.2 OR GPL-2.0-or-later
    -->
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codeberg.org/Vidocq/knock</url>
        <connection>scm:git:https://codeberg.org/Vidocq/knock.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/knock.git</developerConnection>
    </scm>

    <properties>
        <!--
            MicroProfile Health API 4.0.1 - Vidocq fork with module-info
            for Java Modules/jlink. The upstream version is kept for reference.
        -->
        <microprofile.health.api.version>${project.version}</microprofile.health.api.version>
        <microprofile.health.upstream.version>4.0.1</microprofile.health.upstream.version>

        <!-- Jakarta JSON-P - implementation provided by champollion -->
        <jakarta.json.version>2.1.3</jakarta.json.version>

        <!-- Jakarta REST - implementation provided by Cassini -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- CDI -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Vidocq upstreams (referenced via properties to allow cross-repo PR overrides) -->
        <vauban.version>0.3.0-SNAPSHOT</vauban.version>
        <champollion.version>0.3.0-SNAPSHOT</champollion.version>
        <cassini.version>0.3.0-SNAPSHOT</cassini.version>
    </properties>

    <!-- Main reactor modules -->
    <modules>
        <module>knock-mp-health-api</module>
        <module>knock-api</module>
        <module>knock-core</module>
        <module>knock-cdi-vauban</module>
        <module>knock-jaxrs</module>
        <module>knock-tck</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Health API (Vidocq fork with module-info) -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-mp-health-api</artifactId>
                <version>${microprofile.health.api.version}</version>
            </dependency>

            <!-- Jakarta JSON-P (implementation: champollion) -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>

            <!-- Jakarta REST (implementation: Cassini) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Runtime implementations (Vidocq) - versions via properties so
                 the cross-repo PR mechanism can override them. -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Internal Knock modules -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
            Java Modules: the knock-mp-health-api fork includes a module-info and can
            be placed on the module path. We keep target/javamodules to align
            javac/jlink resolution and multi-module builds.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-javamodules-before-copy</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/javamodules</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
