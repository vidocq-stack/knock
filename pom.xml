<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.knock</groupId>
    <artifactId>knock-parent</artifactId>
    <version>0.1.1</version>
    <packaging>pom</packaging>

    <name>Knock</name>
    <description>Implémentation MicroProfile Health 4.0 — zéro librairie tierce, virtual threads, JPMS strict</description>
    <url>https://codeberg.org/Vidocq/knock</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://codeberg.org/Vidocq/knock</url>
        <connection>scm:git:https://codeberg.org/Vidocq/knock.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/knock.git</developerConnection>
    </scm>

    <properties>
        <!--
            MicroProfile Health API 4.0.1 — fork Vidocq avec module-info
            pour JPMS/jlink. La version upstream est gardee a titre indicatif.
        -->
        <microprofile.health.api.version>${project.version}</microprofile.health.api.version>
        <microprofile.health.upstream.version>4.0.1</microprofile.health.upstream.version>

        <!-- Jakarta JSON-P — implémentation fournie par champollion -->
        <jakarta.json.version>2.1.3</jakarta.json.version>

        <!-- Jakarta REST — implémentation fournie par Cassini -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- CDI -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Vidocq upstreams (référencés via property pour overridabilité PR cross-repo) -->
        <vauban.version>0.1.1</vauban.version>
        <champollion.version>0.1.1</champollion.version>
        <cassini.version>0.1.1</cassini.version>
    </properties>

    <!--
        knock-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser
        les POMs Model 4.1.0. Il sera invoqué par run-official-tck-mp-health-4.0.sh
        après installation locale du reactor.
    -->
    <modules>
        <module>knock-mp-health-api</module>
        <module>knock-api</module>
        <module>knock-core</module>
        <module>knock-cdi-vauban</module>
        <module>knock-jaxrs</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Health API (fork Vidocq avec module-info) -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-mp-health-api</artifactId>
                <version>${microprofile.health.api.version}</version>
            </dependency>

            <!-- Jakarta JSON-P (implémentation : champollion) -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>

            <!-- Jakarta REST (implémentation : Cassini) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Implémentations runtime (Vidocq) — versions via property pour
                 que le mécanisme cross-repo PR puisse les overrider. -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Modules internes Knock -->
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.knock</groupId>
                <artifactId>knock-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
            JPMS : le fork knock-mp-health-api embarque un module-info et peut
            etre place sur le module-path. On conserve target/javamodules pour
            aligner la resolution javac/jlink et les builds multi-modules.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-javamodules-before-copy</id>
                        <phase>initialize</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/javamodules</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!--
                        Copie toutes les dependances compile et provided dans target/javamodules.
                        Cela inclut knock-mp-health-api (fork avec module-info),
                        knock-api, jakarta.json, etc. Notre argument javac module-path prend
                        precedence car javac utilise le premier module-path rencontre.
                        includeScope=compile : compile et provided, pas test ni runtime.
                    -->
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
